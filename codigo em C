#include <stdio.h>

int main() {
  float numero1, numero2, resultado;
  char operacao;


  printf("Digite o primeiro numero: ");
  scanf("%f", &numero1);


  printf("Digite o segundo numero: ");
  scanf("%f", &numero2);



  printf("1 - Soma\n");
  printf("2 - Subtracao\n");
  printf("3 - Multiplicacao\n");
  printf("4 - Divisao\n");



  printf("Escolha a operacao: ");
  scanf(" %c", &operacao);



  switch (operacao) {
    case '1':
      resultado = numero1 + numero2;
      printf("Resultado: %.2f", resultado);
      break;



    case '2':
      resultado = numero1 - numero2;
      printf("Resultado: %.2f", resultado);
     break;



    case '3':
      resultado = numero1 * numero2;
      printf("Resultado: %.2f", resultado);
      break;



    case '4':
      if (numero2 == 0) {
        printf("A divisao nao pode ser realizada!");
      } else {
        resultado = numero1 / numero2;
        printf("Resultado: %.2f", resultado);
      }
      break;
    default:
      printf("Operacao inexistente!");
  }


  return 0;
}
